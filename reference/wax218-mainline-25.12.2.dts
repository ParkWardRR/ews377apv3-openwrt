/dts-v1/;
// version: 17
// last_comp_version: 16
// boot_cpuid_phys: 0x0

/ {
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    model = "Netgear WAX218";
    compatible = "netgear,wax218", "qcom,ipq8074";
    interrupt-parent = <0x1>;
    clocks {
        sleep_clk {
            compatible = "fixed-clock";
            clock-frequency = <0x8000>;
            #clock-cells = <0x0>;
            phandle = <0xE>;
        };
        xo {
            compatible = "fixed-clock";
            clock-frequency = <0x124F800>;
            #clock-cells = <0x0>;
            phandle = <0xA>;
        };
        bias_pll_cc_clk {
            compatible = "fixed-clock";
            clock-frequency = <0x11E1A300>;
            #clock-cells = <0x0>;
        };
        bias_pll_nss_noc_clk {
            compatible = "fixed-clock";
            clock-frequency = <0x18D34920>;
            #clock-cells = <0x0>;
        };
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0x0>;
            next-level-cache = <0x2>;
            enable-method = "psci";
            clocks = <0x3 0x1>;
            clock-names = "cpu";
            #cooling-cells = <0x2>;
            operating-points-v2 = <0x4>;
            cpu-supply = <0x5>;
            voltage-tolerance = <0x1>;
            phandle = <0x2D>;
        };
        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            enable-method = "psci";
            reg = <0x1>;
            next-level-cache = <0x2>;
            clocks = <0x3 0x1>;
            clock-names = "cpu";
            #cooling-cells = <0x2>;
            operating-points-v2 = <0x4>;
            cpu-supply = <0x5>;
            voltage-tolerance = <0x1>;
            phandle = <0x2E>;
        };
        cpu@2 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            enable-method = "psci";
            reg = <0x2>;
            next-level-cache = <0x2>;
            clocks = <0x3 0x1>;
            clock-names = "cpu";
            #cooling-cells = <0x2>;
            operating-points-v2 = <0x4>;
            cpu-supply = <0x5>;
            voltage-tolerance = <0x1>;
            phandle = <0x2F>;
        };
        cpu@3 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            enable-method = "psci";
            reg = <0x3>;
            next-level-cache = <0x2>;
            clocks = <0x3 0x1>;
            clock-names = "cpu";
            #cooling-cells = <0x2>;
            operating-points-v2 = <0x4>;
            cpu-supply = <0x5>;
            voltage-tolerance = <0x1>;
            phandle = <0x30>;
        };
        l2-cache {
            compatible = "cache";
            cache-level = <0x2>;
            cache-unified;
            phandle = <0x2>;
        };
    };
    opp-table {
        compatible = "operating-points-v2-kryo-cpu";
        nvmem-cells = <0x6>;
        opp-shared;
        phandle = <0x4>;
        opp-1017600000 {
            opp-hz = <0x0 0x3CA75800>;
            opp-microvolt = <0x1>;
            opp-supported-hw = <0xF>;
            clock-latency-ns = <0x30D40>;
        };
        opp-1382400000 {
            opp-hz = <0x0 0x5265C000>;
            opp-microvolt = <0x2>;
            opp-supported-hw = <0xF>;
            clock-latency-ns = <0x30D40>;
        };
        opp-1651200000 {
            opp-hz = <0x0 0x626B5000>;
            opp-microvolt = <0x3>;
            opp-supported-hw = <0x1>;
            clock-latency-ns = <0x30D40>;
        };
        opp-1843200000 {
            opp-hz = <0x0 0x6DDD0000>;
            opp-microvolt = <0x4>;
            opp-supported-hw = <0x1>;
            clock-latency-ns = <0x30D40>;
        };
        opp-1920000000 {
            opp-hz = <0x0 0x7270E000>;
            opp-microvolt = <0x5>;
            opp-supported-hw = <0x1>;
            clock-latency-ns = <0x30D40>;
        };
        opp-2208000000 {
            opp-hz = <0x0 0x839B6800>;
            opp-microvolt = <0x6>;
            opp-supported-hw = <0x1>;
            clock-latency-ns = <0x30D40>;
        };
    };
    pmu {
        compatible = "arm,cortex-a53-pmu";
        interrupts = <0x1 0x7 0xF04>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    reserved-memory {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        nss@40000000 {
            no-map;
            reg = <0x0 0x40000000 0x0 0x1000000>;
        };
        tzapp@4a400000 {
            no-map;
            reg = <0x0 0x4A400000 0x0 0x200000>;
        };
        bootloader@4a600000 {
            reg = <0x0 0x4A600000 0x0 0x400000>;
            no-map;
        };
        sbl@4aa00000 {
            reg = <0x0 0x4AA00000 0x0 0x100000>;
            no-map;
        };
        smem@4ab00000 {
            compatible = "qcom,smem";
            reg = <0x0 0x4AB00000 0x0 0x100000>;
            no-map;
            hwlocks = <0x7 0x3>;
        };
        memory@4ac00000 {
            reg = <0x0 0x4AC00000 0x0 0x400000>;
            no-map;
        };
        wcnss@4b000000 {
            no-map;
            reg = <0x0 0x4B000000 0x0 0x5F00000>;
            phandle = <0x23>;
        };
        q6_etr_dump@50f00000 {
            no-map;
            reg = <0x0 0x50F00000 0x0 0x100000>;
        };
        m3_dump@51000000 {
            no-map;
            reg = <0x0 0x51000000 0x0 0x100000>;
        };
    };
    firmware {
        scm {
            compatible = "qcom,scm-ipq8074", "qcom,scm";
            qcom,dload-mode = <0x8 0x6100>;
        };
    };
    smp2p-wcss {
        compatible = "qcom,smp2p";
        qcom,smem = <0x1B3 0x1AC>;
        interrupt-parent = <0x1>;
        interrupts = <0x0 0x142 0x1>;
        mboxes = <0x3 0x9>;
        qcom,local-pid = <0x0>;
        qcom,remote-pid = <0x1>;
        master-kernel {
            qcom,entry-name = "master-kernel";
            qcom,smp2p-feature-ssr-ack;
            #qcom,smem-state-cells = <0x1>;
            phandle = <0x22>;
        };
        slave-kernel {
            qcom,entry-name = "slave-kernel";
            interrupt-controller;
            #interrupt-cells = <0x2>;
            phandle = <0x20>;
        };
    };
    soc@0 {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        ranges = <0x0 0x0 0x0 0xFFFFFFFF>;
        compatible = "simple-bus";
        phy@58000 {
            compatible = "qcom,ipq8074-qmp-usb3-phy";
            reg = <0x58000 0x1000>;
            clocks = <0x9 0x82 0xA 0x9 0x86 0x9 0x87>;
            clock-names = "aux", "ref", "cfg_ahb", "pipe";
            clock-output-names = "usb3phy_1_cc_pipe_clk";
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            resets = <0x9 0x2C 0x9 0x2D>;
            reset-names = "phy", "phy_phy";
            status = "disabled";
            phandle = <0x1D>;
        };
        phy@59000 {
            compatible = "qcom,ipq8074-qusb2-phy";
            reg = <0x59000 0x180>;
            #phy-cells = <0x0>;
            clocks = <0x9 0x86 0xA>;
            clock-names = "cfg_ahb", "ref";
            resets = <0x9 0x30>;
            status = "disabled";
            phandle = <0x1C>;
        };
        phy@78000 {
            compatible = "qcom,ipq8074-qmp-usb3-phy";
            reg = <0x78000 0x1000>;
            clocks = <0x9 0x7B 0xA 0x9 0x7F 0x9 0x80>;
            clock-names = "aux", "ref", "cfg_ahb", "pipe";
            clock-output-names = "usb3phy_0_cc_pipe_clk";
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            resets = <0x9 0x29 0x9 0x2A>;
            reset-names = "phy", "phy_phy";
            status = "disabled";
            phandle = <0x1B>;
        };
        phy@79000 {
            compatible = "qcom,ipq8074-qusb2-phy";
            reg = <0x79000 0x180>;
            #phy-cells = <0x0>;
            clocks = <0x9 0x7F 0xA>;
            clock-names = "cfg_ahb", "ref";
            resets = <0x9 0x2F>;
            status = "disabled";
            phandle = <0x1A>;
        };
        phy@84000 {
            compatible = "qcom,ipq8074-qmp-gen3-pcie-phy";
            reg = <0x84000 0x1000>;
            clocks = <0x9 0x70 0x9 0x6F 0x9 0x73>;
            clock-names = "aux", "cfg_ahb", "pipe";
            clock-output-names = "pcie20_phy0_pipe_clk";
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            resets = <0x9 0x4E 0x9 0x4F>;
            reset-names = "phy", "common";
            status = "disabled";
            phandle = <0xF>;
        };
        phy@8e000 {
            compatible = "qcom,ipq8074-qmp-pcie-phy";
            reg = <0x8E000 0x1000>;
            clocks = <0x9 0x76 0x9 0x75 0x9 0x79>;
            clock-names = "aux", "cfg_ahb", "pipe";
            clock-output-names = "pcie20_phy1_pipe_clk";
            #clock-cells = <0x0>;
            #phy-cells = <0x0>;
            resets = <0x9 0x52 0x9 0x53>;
            reset-names = "phy", "common";
            status = "disabled";
            phandle = <0x10>;
        };
        mdio@90000 {
            compatible = "qcom,ipq8074-mdio", "qcom,ipq4019-mdio";
            reg = <0x90000 0x64>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            clocks = <0x9 0xB3>;
            clock-names = "gcc_mdio_ahb_clk";
            clock-frequency = <0x5F5E10>;
            status = "okay";
            pinctrl-0 = <0xB>;
            pinctrl-names = "default";
            reset-gpios = <0xC 0x2C 0x1>;
            phandle = <0x28>;
            ethernet-phy@28 {
                reg = <0x1C>;
                phandle = <0x29>;
            };
        };
        efuse@a4000 {
            compatible = "qcom,ipq8074-qfprom", "qcom,qfprom";
            reg = <0xA4000 0x2000>;
            #address-cells = <0x1>;
            #size-cells = <0x1>;
            speedbin@125 {
                reg = <0x125 0x1>;
                bits = <0x0 0x3>;
                phandle = <0x6>;
            };
            boost_cfg@125 {
                reg = <0x125 0x1>;
                bits = <0x3 0x3>;
            };
            misc_volt_adj@125 {
                reg = <0x125 0x1>;
                bits = <0x3 0x3>;
            };
            boost_volt@126 {
                reg = <0x126 0x1>;
                bits = <0x6 0x1>;
            };
            revision@23e {
                reg = <0x23E 0x1>;
                bits = <0x5 0x3>;
            };
            rosel0@249 {
                reg = <0x249 0x1>;
                bits = <0x0 0x4>;
            };
            rosel1@248 {
                reg = <0x248 0x1>;
                bits = <0x4 0x4>;
            };
            rosel2@248 {
                reg = <0x248 0x2>;
                bits = <0x0 0x4>;
            };
            rosel3@249 {
                reg = <0x249 0x1>;
                bits = <0x4 0x4>;
            };
            ivoltage0@23a {
                reg = <0x23A 0x1>;
                bits = <0x2 0x6>;
            };
            ivoltage1@239 {
                reg = <0x239 0x2>;
                bits = <0x4 0x6>;
            };
            ivoltage2@238 {
                reg = <0x238 0x2>;
                bits = <0x6 0x6>;
            };
            ivoltage3@238 {
                reg = <0x238 0x1>;
                bits = <0x0 0x6>;
            };
            quot0@244 {
                reg = <0x244 0x2>;
                bits = <0x0 0xC>;
            };
            quot1@242 {
                reg = <0x242 0x2>;
                bits = <0x4 0xC>;
            };
            quot2@241 {
                reg = <0x241 0x2>;
                bits = <0x0 0xC>;
            };
            quot3@245 {
                reg = <0x245 0x2>;
                bits = <0x4 0xC>;
            };
            quot0_offset@23d {
                reg = <0x23D 0x2>;
                bits = <0x6 0x7>;
            };
            quot1_offset@23c {
                reg = <0x23C 0x2>;
                bits = <0x7 0x7>;
            };
            quot2_offset@23c {
                reg = <0x23C 0x1>;
                bits = <0x0 0x7>;
            };
        };
        rng@e3000 {
            compatible = "qcom,prng-ee";
            reg = <0xE3000 0x1000>;
            clocks = <0x9 0x28>;
            clock-names = "core";
            status = "disabled";
        };
        thermal-sensor@4a9000 {
            compatible = "qcom,ipq8074-tsens";
            reg = <0x4A9000 0x1000 0x4A8000 0x1000>;
            interrupts = <0x0 0xB8 0x4>;
            interrupt-names = "combined";
            #qcom,sensors = <0x10>;
            #thermal-sensor-cells = <0x1>;
            phandle = <0x2B>;
        };
        dma-controller@704000 {
            compatible = "qcom,bam-v1.7.0";
            reg = <0x704000 0x20000>;
            interrupts = <0x0 0xCF 0x4>;
            clocks = <0x9 0xDA>;
            clock-names = "bam_clk";
            #dma-cells = <0x1>;
            qcom,ee = <0x1>;
            qcom,controlled-remotely;
            status = "disabled";
            phandle = <0xD>;
        };
        crypto@73a000 {
            compatible = "qcom,crypto-v5.1";
            reg = <0x73A000 0x6000>;
            clocks = <0x9 0xDA 0x9 0xDB 0x9 0xDC>;
            clock-names = "iface", "bus", "core";
            dmas = <0xD 0x2 0xD 0x3>;
            dma-names = "rx", "tx";
            status = "disabled";
        };
        pinctrl@1000000 {
            compatible = "qcom,ipq8074-pinctrl";
            reg = <0x1000000 0x300000>;
            interrupts = <0x0 0xD0 0x4>;
            gpio-controller;
            gpio-ranges = <0xC 0x0 0x0 0x46>;
            #gpio-cells = <0x2>;
            interrupt-controller;
            #interrupt-cells = <0x2>;
            phandle = <0xC>;
            serial4-state {
                pins = "gpio23", "gpio24";
                function = "blsp4_uart1";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x14>;
            };
            serial5-state {
                pins = "gpio9", "gpio16";
                function = "blsp5_uart";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x15>;
            };
            i2c-0-state {
                pins = "gpio42", "gpio43";
                function = "blsp1_i2c";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x17>;
            };
            spi-0-state {
                pins = "gpio38", "gpio39", "gpio40", "gpio41";
                function = "blsp0_spi";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x16>;
            };
            hsuart-state {
                pins = "gpio46", "gpio47", "gpio48", "gpio49";
                function = "blsp2_uart";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x13>;
            };
            qpic-state {
                pins = "gpio1", "gpio3", "gpio4", "gpio5", "gpio6", "gpio7", "gpio8", "gpio10", "gpio11", "gpio12", "gpio13", "gpio14", "gpio15", "gpio17";
                function = "qpic";
                drive-strength = <0x8>;
                bias-disable;
                phandle = <0x19>;
            };
            mdio-pins {
                phandle = <0xB>;
                mdc {
                    pins = "gpio68";
                    function = "mdc";
                    drive-strength = <0x8>;
                    bias-pull-up;
                };
                mdio {
                    pins = "gpio69";
                    function = "mdio";
                    drive-strength = <0x8>;
                    bias-pull-up;
                };
            };
        };
        clock-controller@1800000 {
            compatible = "qcom,gcc-ipq8074";
            reg = <0x1800000 0x80000>;
            clocks = <0xA 0xE 0xF 0x10>;
            clock-names = "xo", "sleep_clk", "pcie0_pipe", "pcie1_pipe";
            #clock-cells = <0x1>;
            #power-domain-cells = <0x1>;
            #reset-cells = <0x1>;
            phandle = <0x9>;
        };
        hwlock@1905000 {
            compatible = "qcom,tcsr-mutex";
            reg = <0x1905000 0x20000>;
            #hwlock-cells = <0x1>;
            phandle = <0x7>;
        };
        syscon@1937000 {
            compatible = "qcom,tcsr-ipq8074", "syscon";
            reg = <0x1937000 0x21000>;
            phandle = <0x8>;
        };
        syscon@1945000 {
            compatible = "syscon";
            reg = <0x1945000 0xE000>;
            phandle = <0x21>;
        };
        spmi@200f000 {
            compatible = "qcom,spmi-pmic-arb";
            reg = <0x200F000 0x1000 0x2400000 0x800000 0x2C00000 0x800000 0x3800000 0x200000 0x200A000 0x700>;
            reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
            interrupts = <0x0 0xBE 0x4>;
            interrupt-names = "periph_irq";
            qcom,ee = <0x0>;
            qcom,channel = <0x0>;
            #address-cells = <0x2>;
            #size-cells = <0x0>;
            interrupt-controller;
            #interrupt-cells = <0x4>;
            pmic@0 {
                compatible = "qcom,pmp8074", "qcom,spmi-pmic";
                reg = <0x0 0x0>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                adc@3100 {
                    compatible = "qcom,spmi-adc-rev2";
                    reg = <0x3100>;
                    interrupts = <0x0 0x31 0x0 0x1>;
                    #address-cells = <0x1>;
                    #size-cells = <0x0>;
                    #io-channel-cells = <0x1>;
                    channel@0 {
                        reg = <0x0>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "ref_gnd";
                    };
                    channel@1 {
                        reg = <0x1>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "vref_1p25";
                    };
                    channel@2 {
                        reg = <0x2>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "vref_vadc";
                    };
                    channel@6 {
                        reg = <0x6>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "pmic_die";
                    };
                    channel@76 {
                        reg = <0x4C>;
                        qcom,ratiometric;
                        qcom,hw-settle-time = <0xC8>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "xo_therm";
                    };
                    channel@77 {
                        reg = <0x4D>;
                        qcom,ratiometric;
                        qcom,hw-settle-time = <0xC8>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "pa_therm1";
                    };
                    channel@78 {
                        reg = <0x4E>;
                        qcom,ratiometric;
                        qcom,hw-settle-time = <0xC8>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "pa_therm2";
                    };
                    channel@79 {
                        reg = <0x4F>;
                        qcom,ratiometric;
                        qcom,hw-settle-time = <0xC8>;
                        qcom,pre-scaling = <0x1 0x1>;
                        label = "pa_therm3";
                    };
                    channel@131 {
                        reg = <0x83>;
                        qcom,pre-scaling = <0x1 0x3>;
                        label = "vph_pwr";
                    };
                };
                rtc@6000 {
                    compatible = "qcom,pm8941-rtc";
                    reg = <0x6000 0x6100>;
                    reg-names = "rtc", "alarm";
                    interrupts = <0x0 0x61 0x1 0x0>;
                    allow-set-time;
                    status = "disabled";
                };
                gpio@c000 {
                    compatible = "qcom,pmp8074-gpio", "qcom,spmi-gpio";
                    reg = <0xC000>;
                    gpio-controller;
                    #gpio-cells = <0x2>;
                    gpio-ranges = <0x11 0x0 0x0 0xC>;
                    interrupt-controller;
                    #interrupt-cells = <0x2>;
                    phandle = <0x11>;
                };
            };
            pmic@1 {
                compatible = "qcom,pmp8074", "qcom,spmi-pmic";
                reg = <0x1 0x0>;
                regulators {
                    compatible = "qcom,pmp8074-regulators";
                    s3 {
                        regulator-name = "vdd_s3";
                        regulator-min-microvolt = <0x90880>;
                        regulator-max-microvolt = <0x103C40>;
                        regulator-always-on;
                        regulator-boot-on;
                        phandle = <0x26>;
                    };
                    s4 {
                        regulator-name = "vdd_s4";
                        regulator-min-microvolt = <0xADD40>;
                        regulator-max-microvolt = <0xF2300>;
                        regulator-always-on;
                        regulator-boot-on;
                        phandle = <0x27>;
                    };
                    l11 {
                        regulator-name = "l11";
                        regulator-min-microvolt = <0x1B7740>;
                        regulator-max-microvolt = <0x325AA0>;
                    };
                };
            };
        };
        mmc@7824900 {
            compatible = "qcom,ipq8074-sdhci", "qcom,sdhci-msm-v4";
            reg = <0x7824900 0x500 0x7824000 0x800>;
            reg-names = "hc", "core";
            interrupts = <0x0 0x7B 0x4 0x0 0x8A 0x4>;
            interrupt-names = "hc_irq", "pwr_irq";
            clocks = <0x9 0x89 0x9 0x8A 0xA>;
            clock-names = "iface", "core", "xo";
            resets = <0x9 0x31>;
            max-frequency = <0x16E36000>;
            mmc-ddr-1_8v;
            mmc-hs200-1_8v;
            mmc-hs400-1_8v;
            bus-width = <0x8>;
            status = "disabled";
        };
        dma-controller@7884000 {
            compatible = "qcom,bam-v1.7.0";
            reg = <0x7884000 0x2B000>;
            interrupts = <0x0 0xEE 0x4>;
            clocks = <0x9 0x15>;
            clock-names = "bam_clk";
            #dma-cells = <0x1>;
            qcom,ee = <0x0>;
            phandle = <0x12>;
        };
        serial@78af000 {

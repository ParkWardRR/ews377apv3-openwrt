            compatible = "qcom,nss-dp";
            qcom,id = <0x5>;
            reg = <0x3A003000 0x3FFF>;
            qcom,mactype = <0x1>;
            local-mac-address = [00 00 00 00 00 00];
            phy-mode = "sgmii";
            status = "disabled";
        };
        dp6-syn@3a007000 {
            device_type = "network";
            compatible = "qcom,nss-dp";
            qcom,id = <0x6>;
            reg = <0x3A007000 0x3FFF>;
            qcom,mactype = <0x1>;
            local-mac-address = [00 00 00 00 00 00];
            phy-mode = "sgmii";
            status = "okay";
            phy-handle = <0x29>;
            label = "lan";
            nvmem-cells = <0x2A>;
            nvmem-cell-names = "mac-address";
        };
    };
    timer {
        compatible = "arm,armv8-timer";
        interrupts = <0x1 0x2 0xF08 0x1 0x3 0xF08 0x1 0x4 0xF08 0x1 0x1 0xF08>;
    };

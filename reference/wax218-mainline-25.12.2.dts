    aliases {
        serial0 = "/soc@0/serial@78b3000";
        led-boot = "/leds/led_power";
        led-failsafe = "/leds/led_power";
        led-running = "/leds/led_power";
        led-upgrade = "/leds/led_power";
    };
    chosen {
        stdout-path = "serial0:115200n8";
        bootargs-append = " ubi.block=0,rootfs root=/dev/ubiblock0_1";
    };
    keys {
        compatible = "gpio-keys";
        reset {
            label = "reset";
            gpios = <0xC 0x34 0x1>;
            linux,code = <0x198>;
        };
    };
    led_spi {
        compatible = "spi-gpio";
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        sck-gpios = <0xC 0x12 0x0>;
        mosi-gpios = <0xC 0x13 0x0>;
        led_gpio@0 {
            compatible = "fairchild,74hc595";
            reg = <0x0>;
            gpio-controller;
            #gpio-cells = <0x2>;
            registers-number = <0x1>;
            enable-gpios = <0xC 0x14 0x0>;
            spi-max-frequency = <0xF4240>;
            phandle = <0x3A>;
        };
    };
    leds {
        compatible = "gpio-leds";
        led_power {
            function = "power";
            color = <0x4>;
            gpios = <0x3A 0x1 0x0>;
        };
        led_lan {
            function = "lan";
            color = <0x3>;
            gpios = <0x3A 0x2 0x0>;
        };
        led_wlan_2g {
            label = "blue:wlan2g";
            gpios = <0x3A 0x3 0x0>;
        };
        led_wlan_5g {
            label = "blue:wlan5g";
            gpios = <0x3A 0x4 0x0>;
        };
    };
};
